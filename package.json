{
  "name": "voice-coder",
  "displayName": "Voice Coder",
  "version": "0.1.0",
  "private": true,
  "description": "日本語の音声で generate / explain / debug を指示する VS Code 拡張",
  "publisher": "tsekino",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "file:///D:/work/voice-coder"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.100.0",
    "node": ">=20"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "voiceCoder.toggleListening",
        "title": "音声入力の開始/停止",
        "category": "Voice Coder"
      },
      {
        "command": "voiceCoder.applyProposal",
        "title": "変更案を適用",
        "category": "Voice Coder",
        "icon": "$(check)"
      },
      {
        "command": "voiceCoder.discardProposal",
        "title": "変更案を破棄",
        "category": "Voice Coder",
        "icon": "$(discard)"
      },
      {
        "command": "voiceCoder.selectMicrophone",
        "title": "マイクを選ぶ",
        "category": "Voice Coder"
      }
    ],
    "keybindings": [
      {
        "command": "voiceCoder.toggleListening",
        "key": "ctrl+shift+space",
        "mac": "cmd+shift+space"
      },
      {
        "command": "voiceCoder.applyProposal",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "voiceCoder.hasProposal"
      }
    ],
    "configuration": {
      "title": "Voice Coder",
      "properties": {
        "voiceCoder.micDevice": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "scope": "machine",
          "description": "入力デバイスの番号（コマンド「Voice Coder: マイクを選ぶ」で選べる）。null でシステムの既定のマイク。"
        },
        "voiceCoder.agent": {
          "type": "string",
          "enum": [
            "openai",
            "claude"
          ],
          "default": "openai",
          "enumDescriptions": [
            "OpenAI Responses API（OPENAI_API_KEY）",
            "Claude Agent SDK（ANTHROPIC_API_KEY）"
          ],
          "description": "コマンドを実行する LLM。"
        },
        "voiceCoder.model": {
          "type": "string",
          "default": "",
          "description": "モデル名。空なら openai は gpt-6.1-sol、claude は claude-opus-5-5。"
        },
        "voiceCoder.claudeCodePath": {
          "type": "string",
          "default": "",
          "description": "Claude Code 実行ファイルのパス。空なら SDK 同梱のものを使う。"
        },
        "voiceCoder.maxEndpointDelayMs": {
          "type": "number",
          "default": 1000,
          "description": "Soniox の max_endpoint_delay_ms。"
        },
        "voiceCoder.intentReader": {
          "type": "string",
          "enum": [
            "hybrid",
            "regex",
            "jev"
          ],
          "default": "hybrid",
          "enumDescriptions": [
            "キーワードで読めればそのまま、読めないときだけ jev（TYPESAFE_API_KEY が無ければ正規表現のみ）",
            "正規表現（キーワード）のみ。待ち時間なし",
            "すべて jev（typesafe.ai）。1 回 0.2 秒ほど"
          ],
          "description": "発話から generate / explain / debug を読む方法。行範囲はどれでも正規表現で読む。比較は docs/JEV.md。"
        },
        "voiceCoder.envFile": {
          "type": "string",
          "default": "",
          "description": "API キー（SONIOX_API_KEY / OPENAI_API_KEY / TYPESAFE_API_KEY / ANTHROPIC_API_KEY）を書いた .env のパス。相対パスはワークスペースから。環境変数があればそちらが優先。値はこの拡張の中だけで使い、VS Code の環境変数には入れない。",
          "scope": "machine"
        },
        "voiceCoder.replayWav": {
          "type": "string",
          "default": "",
          "description": "動作確認用: マイクの代わりにこの WAV（16 kHz モノラル 16 bit）を実時間で流す。空ならマイク。",
          "scope": "machine"
        },
        "voiceCoder.languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "ja",
            "en"
          ],
          "description": "音声認識の言語ヒント（Soniox）。日本語と英語のどちらで話してもよい既定値。"
        },
        "voiceCoder.messageLanguage": {
          "type": "string",
          "enum": [
            "auto",
            "ja",
            "en"
          ],
          "default": "auto",
          "enumDescriptions": [
            "直前に話した言語に合わせる（最初は日本語）",
            "常に日本語",
            "常に英語"
          ],
          "description": "ステータスバーや通知の言語。"
        },
        "voiceCoder.stopAfterUtterance": {
          "type": "boolean",
          "default": true,
          "description": "話し終えて指示が確定したら、自動で聞き取りを止める（押す → 話す → 自動で止まる）。オフにすると、もう一度押すまで聞き続ける。"
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "voiceCoder.applyProposal",
          "when": "voiceCoder.hasProposal",
          "group": "navigation@1"
        },
        {
          "command": "voiceCoder.discardProposal",
          "when": "voiceCoder.hasProposal",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "voiceCoder.applyProposal",
          "when": "voiceCoder.hasProposal"
        },
        {
          "command": "voiceCoder.discardProposal",
          "when": "voiceCoder.hasProposal"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node esbuild.mjs",
    "vscode:prepublish": "npm run build",
    "test": "vitest run && node out/test/runTest.cjs",
    "test:unit": "vitest run",
    "test:vscode": "node out/test/runTest.cjs",
    "gen:audio": "tsx scripts/gen_audio.ts",
    "latency": "tsx scripts/latency_report.ts",
    "try:agent": "tsx scripts/try_agent.ts",
    "jev:compare": "tsx scripts/jev_compare.ts",
    "mic": "tsx scripts/mic.ts",
    "stt:compare": "tsx scripts/stt_compare.ts",
    "demo": "tsx scripts/demo/record_demo.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.288",
    "@picovoice/pvrecorder-node": "^1.2.9",
    "@typesafe-ai/sdk": "^0.6.0",
    "openai": "^7.27.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.100.0",
    "@types/ws": "^8.18.2",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "mocha": "^12.0.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
